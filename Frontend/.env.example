# ============================================================
# Smart Medicine Availability & Intelligent Janaushadhi
# Recommendation System — Frontend Environment Configuration
#
# Version : 1.0.0
# Type    : Final Year Engineering Project
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file → .env
#   2. Fill in values for your environment
#   3. Never commit .env to version control
# ============================================================

# ── Application ──────────────────────────────────────────────
VITE_APP_NAME=Smart Medicine System
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development        # development | staging | production

# ── Backend API (FastAPI) ─────────────────────────────────────
# Base URL for the FastAPI backend.
# Change to staging/production URL when deploying.
VITE_API_BASE_URL=http://127.0.0.1:8002/api/v1
VITE_OCR_API_URL=http://127.0.0.1:8001/api/v1

# ── Future API Endpoints (reference) ─────────────────────────
# These will be used by service files once the backend is ready.
#
# Authentication:
#   POST /api/v1/auth/register
#   POST /api/v1/auth/login
#   POST /api/v1/auth/verify-otp
#   POST /api/v1/auth/resend-otp
#   POST /api/v1/auth/forgot-password
#   POST /api/v1/auth/reset-password
#   POST /api/v1/auth/refresh-token
#   POST /api/v1/auth/logout
#
# Medicines:
#   GET  /api/v1/medicines/search?q=...
#   GET  /api/v1/medicines/:id
#   GET  /api/v1/medicines/alternatives/:id
#   GET  /api/v1/medicines/popular
#   GET  /api/v1/medicines/categories
#   POST /api/v1/medicines              (admin)
#   PUT  /api/v1/medicines/:id          (admin)
#
# Pharmacies:
#   GET  /api/v1/pharmacies/nearby?lat=...&lng=...
#   GET  /api/v1/pharmacies/:id
#   GET  /api/v1/pharmacies/:id/inventory
#
# Users:
#   GET  /api/v1/users/me
#   PUT  /api/v1/users/me
#   GET  /api/v1/users/me/notifications
#   GET  /api/v1/users/me/saved-medicines
#   GET  /api/v1/users/me/search-history
#
# Admin:
#   GET  /api/v1/admin/users
#   GET  /api/v1/admin/pharmacies
#   GET  /api/v1/admin/medicines
#   GET  /api/v1/admin/generic-mappings
#   GET  /api/v1/admin/analytics
#   GET  /api/v1/admin/stats
#
# Inventory (Pharmacy):
#   GET  /api/v1/pharmacy/inventory
#   POST /api/v1/pharmacy/inventory
#   PUT  /api/v1/pharmacy/inventory/:id
#   DELETE /api/v1/pharmacy/inventory/:id
